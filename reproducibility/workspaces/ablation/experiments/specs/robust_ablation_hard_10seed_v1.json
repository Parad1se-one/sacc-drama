{
  "schema_version": 1,
  "name": "robust_ablation_hard_10seed_v1",
  "reviewer_item": "C3/C4 matched ten-seed Hard study",
  "difficulty": "hard",
  "train_start_protocol": "fixed",
  "selection_start_set": "experiments/protocols/v1/hard_selection_starts.json",
  "final_random_start_set": "experiments/protocols/v1/hard_test_starts.json",
  "seeds": [42, 123, 456, 789, 2024, 207668, 649032, 305, 904400, 459207],
  "common_args": {
    "episodes": 3000,
    "max_steps": 500,
    "ppo_epochs": 4,
    "mini_batch_size": 64,
    "clip_eps": 0.2,
    "actor_lr": 0.0003,
    "critic_lr": 0.0003,
    "gamma": 0.99,
    "lam": 0.95,
    "grad_clip": 10.0,
    "entropy_coef": 0.005,
    "eval_interval": 100,
    "eval_episodes": 20,
    "eval_seed": 100042,
    "save_interval": 100,
    "actor_hidden_dim": 128,
    "critic_hidden_dim": 256,
    "env_reward_scale": 1.0,
    "rm_reward_scale": 1.0,
    "team_progress_bonus_coeff": 0.2,
    "train_temperature_start": 1.0,
    "train_temperature_final": 1.0,
    "eval_policy_mode": "greedy",
    "eval_temperature": 0.35,
    "reward_stage_event": 1.0,
    "reward_stage_done": 1.5,
    "reward_all_done": 4.0,
    "penalty_idle": -0.002,
    "penalty_no_effect": -0.1,
    "penalty_blocked": -0.05,
    "distance_shaping_coeff": 0.02,
    "early_stop_patience_evals": 0,
    "early_stop_min_episode": 0
  },
  "variants": [
    {"name": "full", "description": "Complete SACC package", "overrides": {}},
    {
      "name": "no_actor_progress",
      "description": "Zero the nine actor-side progress features",
      "overrides": {"disable_actor_rm": true}
    },
    {
      "name": "no_critic_progress",
      "description": "Zero critic-side global progress features",
      "overrides": {"disable_critic_rm": true}
    },
    {
      "name": "no_structured_reward",
      "description": "Remove RM, progress-bonus, and distance-shaping rewards",
      "overrides": {
        "rm_reward_scale": 0.0,
        "team_progress_bonus_coeff": 0.0,
        "distance_shaping_coeff": 0.0
      }
    },
    {
      "name": "all_off",
      "description": "Matched HAPPO-style backbone with all SACC additions disabled",
      "overrides": {
        "disable_actor_rm": true,
        "disable_critic_rm": true,
        "rm_reward_scale": 0.0,
        "team_progress_bonus_coeff": 0.0,
        "distance_shaping_coeff": 0.0
      }
    }
  ],
  "reported_metrics": [
    "final_completion",
    "final_success",
    "final_steps",
    "completion_auc",
    "first_eval_nonzero_success_episode",
    "first_eval_full_success_episode",
    "last_five_eval_success",
    "last_five_eval_completion"
  ]
}
